/* FastRPC interface for the standalone HTP bring-up probe. */

#ifndef QWEN3_PROBE_IDL
#define QWEN3_PROBE_IDL

#include "AEEStdDef.idl"
#include "remote.idl"

interface qwen3_probe : remote_handle64 {
    AEEResult prepare();
    AEEResult release();
    AEEResult resource_info(in int32 shared_fd, in uint32 shared_bytes);
    AEEResult run(in int32 shared_fd, in uint32 shared_bytes);
    AEEResult run_hmx_convert(in int32 shared_fd, in uint32 shared_bytes);
    AEEResult run_mlp(in int32 shared_fd, in uint32 shared_bytes);
    AEEResult run_attention(in int32 shared_fd, in uint32 shared_bytes);
    AEEResult run_block(in int32 shared_fd, in uint32 shared_bytes);
};

#endif
